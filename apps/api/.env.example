# ----------------------------
# Environment configuration example
# ----------------------------

# Node environment: development, production, or test
NODE_ENV=development

# Port your application will run on
PORT=4000

# URL of the frontend client application (used for CORS, redirects, etc.)
CLIENT_URL=http://localhost:3000

# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/database

# PostgreSQL username
POSTGRES_USER=user

# PostgreSQL password
POSTGRES_PASSWORD=password

# PostgreSQL database name
POSTGRES_DB=database

# PostgreSQL port
POSTGRES_PORT=5432

# Token expiration time (e.g. 1d = 1 day, 12h = 12 hours)
JWT_EXPIRES_IN="1d"

# Secret key used to sign JWT tokens (keep this secure in production)
JWT_SECRET=secretkey

# Default password used when seeding users into the database
DEFAULT_PASSWORD_USER_SEED=password